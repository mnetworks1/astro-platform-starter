            color: #FF6600;
            margin-bottom: 10px;
        }
        #userPortal .portal-content .summary-card p {
            font-size: 2em;
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
            color: #FFFFFF;
        }
        #userPortal #request-payout-btn {
