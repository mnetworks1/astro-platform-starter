        function validateStep1() {
            let isValid = true;
            const firstName = document.getElementById('reg-firstname');
            const lastName = document.getElementById('reg-lastname');
            const email = document.getElementById('reg-email');
            const phone = document.getElementById('reg-phone');

            if (firstName.value.trim() === '') {
                document.getElementById('error-firstname').textContent = 'First Name is required.';
                isValid = false;
            } else {
                document.getElementById('error-firstname').textContent = '';
            }

            if (lastName.value.trim() === '') {
                document.getElementById('error-lastname').textContent = 'Last Name is required.';
                isValid = false;
            } else {
                document.getElementById('error-lastname').textContent = '';
            }

            if (email.value.trim() === '' || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value)) {
                document.getElementById('error-email').textContent = 'Valid Email is required.';
                isValid = false;
            } else {
                document.getElementById('error-email').textContent = '';
            }

            if (phone.value.trim() === '' || !/^\+?\d{10,15}$/.test(phone.value)) { // Basic phone validation
                document.getElementById('error-phone').textContent = 'Valid Phone Number is required (e.g., +27123456789).';
                isValid = false;
            } else {
                document.getElementById('error-phone').textContent = '';
            }

            return isValid;
        }

        function validateStep2() {
            let isValid = true;
            const username = document.getElementById('reg-username');
            const password = document.getElementById('reg-password');
            const confirmPassword = document.getElementById('reg-confirm-password');

            if (username.value.trim() === '' || username.value.length < 4) {
                document.getElementById('error-username-reg').textContent = 'Username must be at least 4 characters.';
                isValid = false;
            } else if (users[username.value.trim()]) {
                 document.getElementById('error-username-reg').textContent = 'Username already taken.';
                isValid = false;
            }
            else {
                document.getElementById('error-username-reg').textContent = '';
            }

            if (password.value.trim() === '' || password.value.length < 6) {
                document.getElementById('error-password-reg').textContent = 'Password must be at least 6 characters.';
                isValid = false;
            } else {
                document.getElementById('error-password-reg').textContent = '';
            }

            if (password.value !== confirmPassword.value) {
                document.getElementById('error-confirm-password').textContent = 'Passwords do not match.';
                isValid = false;
            } else {
                document.getElementById('error-confirm-password').textContent = '';
            }

            return isValid;
        }

        function validateStep3() {
            let isValid = true;
            const address1 = document.getElementById('reg-address-line1');
            const city = document.getElementById('reg-city');
            const province = document.getElementById('reg-province');
            const postalCode = document.getElementById('reg-postal-code');

            if (address1.value.trim() === '') {
                document.getElementById('error-address1').textContent = 'Address Line 1 is required.';
                isValid = false;
            } else {
                document.getElementById('error-address1').textContent = '';
            }

            if (city.value.trim() === '') {
                document.getElementById('error-city').textContent = 'City is required.';
                isValid = false;
            } else {
                document.getElementById('error-city').textContent = '';
            }

            if (province.value.trim() === '') {
                document.getElementById('error-province').textContent = 'Province is required.';
                isValid = false;
            } else {
                document.getElementById('error-province').textContent = '';
            }

            if (postalCode.value.trim() === '' || !/^\d{4}$/.test(postalCode.value)) { // Basic SA postal code validation
                document.getElementById('error-postalcode').textContent = 'Valid Postal Code (4 digits) is required.';
                isValid = false;
            } else {
                document.getElementById('error-postalcode').textContent = '';
            }

            return isValid;
        }

