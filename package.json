        // --- Shopping Cart Functionality ---
        addServiceToCartBtn.addEventListener('click', (e) => {
            const serviceId = e.target.dataset.serviceId;
            const service = services[serviceId];

            if (service) {
                const existingItem = cart.find(item => item.id === serviceId);
                if (existingItem) {
                    existingItem.quantity++;
                } else {
                    cart.push({
                        id: serviceId,
                        name: service.title,
                        price: service.price,
                        quantity: 1
                    });
                }
                localStorage.setItem('cart', JSON.stringify(cart)); // Save cart to localStorage
                updateCartDisplay();
                closeModal(serviceDetailModal);
            }
        });

        cartIcon.addEventListener('click', () => {
            updateCartDisplay();
            openModal(cartModal);
        });

        function updateCartDisplay() {
            cartItemsTableBody.innerHTML = ''; // Clear existing items
            let total = 0;

            if (cart.length === 0) {
                cartItemsTableBody.innerHTML = '<tr><td colspan="3">Your cart is empty.</td></tr>';
                cartCount.style.display = 'none';
            } else {
                cart.forEach(item => {
                    const row = cartItemsTableBody.insertRow();
                    row.innerHTML = `
                        <td>${item.name}</td>
                        <td>R${item.price.toFixed(2)} x ${item.quantity}</td>
                        <td>
                            <button class="btn-primary btn-sm remove-from-cart-btn" data-service-id="${item.id}" style="background-color: #dc3545;">Remove</button>
                        </td>
                    `;
                    total += item.price * item.quantity;
                });
                cartCount.style.display = 'block';
                cartCount.textContent = cart.reduce((sum, item) => sum + item.quantity, 0);
            }
            cartTotalDisplay.textContent = `Total: R${total.toFixed(2)}`;

            // Add event listeners for remove buttons
            document.querySelectorAll('.remove-from-cart-btn').forEach(button => {
                button.addEventListener('click', (e) => {
                    const serviceIdToRemove = e.target.dataset.serviceId;
                    removeItemFromCart(serviceIdToRemove);
                });
            });
        }

        function removeItemFromCart(serviceId) {
            const itemIndex = cart.findIndex(item => item.id === serviceId);
            if (itemIndex > -1) {
                if (cart[itemIndex].quantity > 1) {
                    cart[itemIndex].quantity--;
                } else {
                    cart.splice(itemIndex, 1);
                }
            }
            localStorage.setItem('cart', JSON.stringify(cart)); // Update localStorage
            updateCartDisplay();
        }

        clearCartBtn.addEventListener('click', () => {
            cart = [];
            localStorage.setItem('cart', JSON.stringify(cart)); // Clear cart in localStorage
            updateCartDisplay();
        });

        proceedToCheckoutBtn.addEventListener('click', () => {
            if (cart.length === 0) {
                alert('Your cart is empty. Please add services before checking out.');
                return;
            }
            closeModal(cartModal);

            if (!currentUser) {
                // If not logged in, prompt for login/registration
                openModal(loginModal);
                loginErrorMessage.textContent = 'Please login or register to proceed with your order.';
                loginErrorMessage.style.display = 'block';
            } else {
                // If logged in, proceed to generate invoice
                generateInvoice();
            }
        });

        // --- Invoice Generation ---
        function generateInvoice() {
            if (!currentUser) {
                console.error("No current user to generate invoice for.");
                return;
            }

            const invoiceDate = new Date().toLocaleDateString('en-ZA'); // South African date format
            const invoiceNumber = `INV-${Math.floor(Math.random() * 1000000)}`; // Simple random invoice number
            const dueDate = new Date();
            dueDate.setDate(dueDate.getDate() + 14); // 14 days from now
            const invoiceDueDate = dueDate.toLocaleDateString('en-ZA');

            document.getElementById('invoice-date').textContent = invoiceDate;
            document.getElementById('invoice-number').textContent = invoiceNumber;

            const clientUser = users[currentUser.username];
            document.getElementById('invoice-client-name').textContent = `${clientUser.firstName} ${clientUser.lastName}`;
            document.getElementById('invoice-client-address').textContent = `${clientUser.address1}, ${clientUser.city}, ${clientUser.province}, ${clientUser.postalCode}`;
            document.getElementById('invoice-client-email').textContent = clientUser.email;


            const invoiceTableBody = document.getElementById('invoice-items-table-body');
            invoiceTableBody.innerHTML = '';
            let subtotal = 0;

            cart.forEach(item => {
                const row = invoiceTableBody.insertRow();
                const totalItemPrice = item.price * item.quantity;
                row.innerHTML = `
                    <td>${item.name}</td>
                    <td>${item.quantity}</td>
                    <td>R${item.price.toFixed(2)}</td>
                    <td>R${totalItemPrice.toFixed(2)}</td>
                `;
                subtotal += totalItemPrice;
            });

            const taxRate = 0.15; // 15% VAT
            const taxAmount = subtotal * taxRate;
            const grandTotal = subtotal + taxAmount;

            document.getElementById('invoice-subtotal').textContent = subtotal.toFixed(2);
            document.getElementById('invoice-tax').textContent = taxAmount.toFixed(2);
            document.getElementById('invoice-grand-total').textContent = grandTotal.toFixed(2);

            // Store invoice and service in user's data (simulated backend)
            const newInvoice = {
                invoiceNum: invoiceNumber,
                date: invoiceDate,
                amount: grandTotal,
                dueDate: invoiceDueDate,
                status: 'Unpaid',
                items: cart // Save cart items with the invoice
            };

            const newService = {
                name: cart.map(item => item.name).join(', '), // Combine service names
                activationDate: invoiceDate,
                nextDueDate: invoiceDueDate, // Use invoice due date as next due for simplicity
                status: 'Active'
            };

            if (!users[currentUser.username].invoices) {
                users[currentUser.username].invoices = [];
            }
            if (!users[currentUser.username].services) {
                users[currentUser.username].services = [];
            }
            users[currentUser.username].invoices.push(newInvoice);
            users[currentUser.username].services.push(newService);

            // Also add to admin's list of all invoices
            const adminInvoiceEntry = {
                invoiceNum: newInvoice.invoiceNum,
                clientUsername: currentUser.username,
                amount: newInvoice.amount,
                date: newInvoice.date,
                dueDate: newInvoice.dueDate,
                status: newInvoice.status
            };
            adminInvoices.push(adminInvoiceEntry);

            localStorage.setItem('users', JSON.stringify(users)); // Update users data in localStorage
            localStorage.setItem('adminInvoices', JSON.stringify(adminInvoices)); // Update admin invoices in localStorage

            // Clear the cart after generating invoice
            cart = [];
            localStorage.setItem('cart', JSON.stringify(cart));
            updateCartDisplay(); // Update cart icon to 0

            openModal(invoiceModal);
            // Optionally, redirect to client portal invoices section
            setTimeout(() => {
                closeModal(invoiceModal);
                showUserPortal(currentUser.username);
                document.querySelector('.portal-nav-btn[data-target="invoices"]').click();
            }, 3000); // Close invoice after 3 seconds and redirect
        }

        document.getElementById('download-invoice-btn').addEventListener('click', () => {
            alert('Invoice download simulated! (In a real app, this would generate a PDF)');
            // You'd use a library like jsPDF here
        });

        document.getElementById('send-invoice-btn').addEventListener('click', () => {
            alert('Invoice sent via email simulated! (In a real app, this would send an email)');
        });


        // --- User/Client Portal Logic ---
        function showUserPortal(username) {
            userPortal.style.display = 'block';
            document.getElementById('portal-welcome-message').textContent = `Welcome, ${username}!`;
            document.querySelectorAll('#userPortal .portal-nav-btn')[0].click(); // Activate Dashboard by default
            updateUserPortalData(username);
        }

        function updateUserPortalData(username) {
            const user = users[username];
            if (!user) return;

            // Dashboard Summary
            const activeServicesCount = user.services ? user.services.filter(s => s.status === 'Active').length : 0;
            const unpaidInvoicesCount = user.invoices ? user.invoices.filter(i => i.status === 'Unpaid').length : 0;
            document.getElementById('dashboard-active-services').textContent = activeServicesCount;
            document.getElementById('dashboard-unpaid-invoices').textContent = unpaidInvoicesCount;
            document.getElementById('dashboard-affiliate-earnings').textContent = user.affiliateEarnings ? user.affiliateEarnings.toFixed(2) : '0.00';

            // Recent Activity (simplified)
            const recentActivityTableBody = document.querySelector('#recent-activity-table tbody');
            recentActivityTableBody.innerHTML = '';
            // For demo, just show last 2 invoices/services
            const recentInvoices = (user.invoices || []).slice(-2).reverse();
            const recentServices = (user.services || []).slice(-2).reverse();

            recentInvoices.forEach(inv => {
                const row = recentActivityTableBody.insertRow();
                row.innerHTML = `<td>${inv.date}</td><td>Invoice Generated</td><td>#${inv.invoiceNum} (R${inv.amount.toFixed(2)})</td>`;
            });
            recentServices.forEach(srv => {
                const row = recentActivityTableBody.insertRow();
                row.innerHTML = `<td>${srv.activationDate}</td><td>Service Activated</td><td>${srv.name}</td>`;
            });
            if (recentInvoices.length === 0 && recentServices.length === 0) {
                 recentActivityTableBody.innerHTML = '<tr><td colspan="3">No recent activity.</td></tr>';
            }


            // My Services
            const servicesTableBody = document.getElementById('services-table').querySelector('tbody');
            servicesTableBody.innerHTML = '';
            if (user.services && user.services.length > 0) {
                user.services.forEach(service => {
                    const row = servicesTableBody.insertRow();
                    row.innerHTML = `
                        <td>${service.name}</td>
                        <td>${service.activationDate}</td>
                        <td>${service.nextDueDate}</td>
                        <td class="status-${service.status.toLowerCase()}">${service.status}</td>
                        <td><button class="btn-primary btn-sm">Manage</button></td>
                    `;
                });
            } else {
                servicesTableBody.innerHTML = '<tr><td colspan="5">No services found.</td></tr>';
            }


            // My Invoices
            const invoicesTableBody = document.getElementById('invoices-table').querySelector('tbody');
            invoicesTableBody.innerHTML = '';
            if (user.invoices && user.invoices.length > 0) {
                user.invoices.forEach(invoice => {
                    const row = invoicesTableBody.insertRow();
                    row.innerHTML = `
                        <td>${invoice.invoiceNum}</td>
                        <td>${invoice.date}</td>
                        <td>R${invoice.amount.toFixed(2)}</td>
                        <td>${invoice.dueDate}</td>
                        <td class="status-${invoice.status.toLowerCase()}">${invoice.status}</td>
                        <td><button class="btn-primary btn-sm">View/Pay</button></td>
                    `;
                });
            } else {
                invoicesTableBody.innerHTML = '<tr><td colspan="6">No invoices found.</td></tr>';
            }

            // Profile
            document.getElementById('profile-firstname').value = user.firstName || '';
            document.getElementById('profile-lastname').value = user.lastName || '';
            document.getElementById('profile-email').value = user.email || '';
            document.getElementById('profile-phone').value = user.phone || '';
            document.getElementById('profile-address1').value = user.address1 || '';
            document.getElementById('profile-city').value = user.city || '';
            document.getElementById('profile-province').value = user.province || '';
            document.getElementById('profile-postal-code').value = user.postalCode || '';

            // Affiliate
            document.getElementById('affiliate-pending-earnings').textContent = user.affiliateEarnings ? user.affiliateEarnings.toFixed(2) : '0.00';
            document.getElementById('affiliate-total-paid').textContent = user.totalPaidOut ? user.totalPaidOut.toFixed(2) : '0.00';
            document.getElementById('bank-name').value = user.bankingDetails.bankName || '';
            document.getElementById('account-name').value = user.bankingDetails.accountName || '';
            document.getElementById('account-number').value = user.bankingDetails.accountNumber || '';
            document.getElementById('account-type').value = user.bankingDetails.accountType || '';
            document.getElementById('branch-code').value = user.bankingDetails.branchCode || '';
        }

        document.querySelectorAll('#userPortal .portal-nav-btn').forEach(button => {
            button.addEventListener('click', (e) => {
                const targetId = e.target.dataset.target;

                // Deactivate all content sections
                document.querySelectorAll('#userPortal .portal-content').forEach(content => {
                    content.style.display = 'none';
                });

                // Activate the selected content section
                document.getElementById(`portal-${targetId}`).style.display = 'block';

                // Update active button state
                document.querySelectorAll('#userPortal .portal-nav-btn').forEach(btn => btn.classList.remove('active'));
                e.target.classList.add('active');

                // Refresh data for the opened tab
                if (currentUser) {
                    updateUserPortalData(currentUser.username);
                }
            });
        });

        // Affiliate program payout request
        document.getElementById('payout-request-form').addEventListener('submit', (e) => {
            e.preventDefault();
            const payoutAmount = parseFloat(document.getElementById('payout-amount').value);
            const user = users[currentUser.username];

            if (payoutAmount < 100) {
                alert('Minimum payout amount is R100.00.');
                return;
            }
            if (payoutAmount > user.affiliateEarnings) {
                alert('You cannot request more than your pending earnings.');
                return;
            }

            // Simulate payout request
            user.affiliateEarnings -= payoutAmount;
            user.totalPaidOut += payoutAmount;
            localStorage.setItem('users', JSON.stringify(users));
            updateUserPortalData(currentUser.username);
            alert(`Payout request for R${payoutAmount.toFixed(2)} submitted!`);
            document.getElementById('payout-amount').value = '';
        });

        // Banking details update
        document.getElementById('banking-details-form').addEventListener('submit', (e) => {
            e.preventDefault();
            const user = users[currentUser.username];
            user.bankingDetails = {
                bankName: document.getElementById('bank-name').value,
                accountName: document.getElementById('account-name').value,
                accountNumber: document.getElementById('account-number').value,
                accountType: document.getElementById('account-type').value,
                branchCode: document.getElementById('branch-code').value
            };
            localStorage.setItem('users', JSON.stringify(users));
            alert('Banking details updated successfully! (This is a demo.)');
        });

        // Profile update
        document.getElementById('profile-update-form').addEventListener('submit', (e) => {
            e.preventDefault();
            const user = users[currentUser.username];
            user.firstName = document.getElementById('profile-firstname').value;
            user.lastName = document.getElementById('profile-lastname').value;
            user.phone = document.getElementById('profile-phone').value;
            user.address1 = document.getElementById('profile-address1').value;
            user.city = document.getElementById('profile-city').value;
            user.province = document.getElementById('profile-province').value;
            user.postalCode = document.getElementById('profile-postal-code').value;
            localStorage.setItem('users', JSON.stringify(users));
            alert('Profile updated successfully! (This is a demo.)');
            document.getElementById('portal-welcome-message').textContent = `Welcome, ${user.firstName}!`; // Update welcome message
        });

        // Change password
        document.getElementById('change-password-form').addEventListener('submit', (e) => {
            e.preventDefault();
            const currentPass = document.getElementById('current-password').value;
            const newPass = document.getElementById('new-password').value;
            const confirmNewPass = document.getElementById('confirm-new-password').value;
            const user = users[currentUser.username];

            if (currentPass === '' || newPass === '' || confirmNewPass === '') {
                alert('All password fields are required.');
                return;
            }
            if (currentPass !== user.passwordHash) { // Demo check
                alert('Current password is incorrect.');
                return;
            }
            if (newPass.length < 6) {
                alert('New password must be at least 6 characters.');
                return;
            }
            if (newPass !== confirmNewPass) {
                alert('New password and confirm password do not match.');
                return;
            }

            user.passwordHash = newPass; // Update hashed password
            localStorage.setItem('users', JSON.stringify(users));
            alert('Password changed successfully! (This is a demo.)');
            document.getElementById('change-password-form').reset();
        });


        // --- Admin Portal Logic ---
        function showAdminPortal() {
            adminPortal.style.display = 'block';
            document.querySelectorAll('#adminPortal .admin-nav-btn')[0].click(); // Activate Overview by default
            initAdminCharts();
            updateAdminDashboardData();
            updateAdminUsersTable();
            updateAdminInvoicesTable();
            updateAdminChatUsers(); // Initialize admin chat users list
        }

        function updateAdminDashboardData() {
            const totalClients = Object.keys(users).length;
            const activeServices = Object.values(users).reduce((count, user) => {
                if (user.services) {
                    return count + user.services.filter(s => s.status === 'Active').length;
                }
                return count;
            }, 0);
            const pendingPayouts = Object.values(users).reduce((sum, user) => {
                if (user.affiliateEarnings) {
                    return sum + user.affiliateEarnings;
                }
                return sum;
            }, 0);
            const monthlyRevenue = adminInvoices.reduce((sum, invoice) => {
                const invoiceDate = new Date(invoice.date.split('/').reverse().join('-')); // Convert DD/MM/YYYY to YYYY-MM-DD
                const currentMonth = new Date().getMonth();
                const currentYear = new Date().getFullYear();
                if (invoiceDate.getMonth() === currentMonth && invoiceDate.getFullYear() === currentYear) {
                    return sum + invoice.amount;
                }
                return sum;
            }, 0);

            document.getElementById('admin-total-clients').textContent = totalClients;
            document.getElementById('admin-total-active-services').textContent = activeServices;
            document.getElementById('admin-pending-payouts').textContent = pendingPayouts.toFixed(2);
            document.getElementById('admin-monthly-revenue').textContent = monthlyRevenue.toFixed(2);
        }

        function updateAdminUsersTable() {
            const adminUsersTableBody = document.getElementById('admin-users-table').querySelector('tbody');
            adminUsersTableBody.innerHTML = '';
            let userIdCounter = 1; // Simple counter for demo IDs

            for (const username in users) {
                const user = users[username];
                const row = adminUsersTableBody.insertRow();
                row.innerHTML = `
                    <td>${userIdCounter++}</td>
                    <td>${user.firstName} ${user.lastName}</td>
                    <td>${user.email}</td>
                    <td class="status-${user.role === 'client' ? 'active' : 'inactive'}">${user.role === 'client' ? 'Active' : 'Admin/Manager'}</td>
                    <td>${'N/A'}</td> <td><button class="btn-primary btn-sm">Edit</button> <button class="btn-primary btn-sm" style="background-color: #dc3545;">${user.role === 'client' ? 'Deactivate' : 'Remove'}</button></td>
                `;
            }
        }

        function updateAdminInvoicesTable() {
            const adminInvoicesTableBody = document.getElementById('admin-invoices-table').querySelector('tbody');
            adminInvoicesTableBody.innerHTML = '';

            if (adminInvoices.length === 0) {
                adminInvoicesTableBody.innerHTML = '<tr><td colspan="6">No invoices recorded yet.</td></tr>';
                return;
            }

            adminInvoices.forEach(invoice => {
                const row = adminInvoicesTableBody.insertRow();
                row.innerHTML = `
                    <td>${invoice.invoiceNum}</td>
                    <td>${invoice.clientUsername}</td>
                    <td>R${invoice.amount.toFixed(2)}</td>
                    <td class="status-${invoice.status.toLowerCase()}">${invoice.status}</td>
                    <td>${invoice.dueDate}</td>
                    <td><button class="btn-primary btn-sm">View</button> <button class="btn-primary btn-sm mark-paid-btn" data-invoice-num="${invoice.invoiceNum}">Mark Paid</button></td>
                `;
            });

            // Add event listeners for "Mark Paid" buttons
            document.querySelectorAll('.mark-paid-btn').forEach(button => {
                button.addEventListener('click', (e) => {
                    const invoiceNum = e.target.dataset.invoiceNum;
                    markInvoiceAsPaid(invoiceNum);
                });
            });
        }

        function markInvoiceAsPaid(invoiceNum) {
            // Update adminInvoices
            const adminInvoiceIndex = adminInvoices.findIndex(inv => inv.invoiceNum === invoiceNum);
            if (adminInvoiceIndex > -1) {
                adminInvoices[adminInvoiceIndex].status = 'Paid';
                localStorage.setItem('adminInvoices', JSON.stringify(adminInvoices));
            }

            // Update client's invoices
            for (const username in users) {
                const user = users[username];
                if (user.invoices) {
                    const clientInvoiceIndex = user.invoices.findIndex(inv => inv.invoiceNum === invoiceNum);
                    if (clientInvoiceIndex > -1) {
                        user.invoices[clientInvoiceIndex].status = 'Paid';
                        localStorage.setItem('users', JSON.stringify(users));
                        break; // Invoice found and updated, no need to continue
                    }
                }
            }
            updateAdminInvoicesTable(); // Refresh admin invoice view
            alert(`Invoice ${invoiceNum} marked as paid!`);
        }


        document.querySelectorAll('#adminPortal .admin-nav-btn').forEach(button => {
            button.addEventListener('click', (e) => {
                const targetId = e.target.dataset.target;

                // Deactivate all content sections
                document.querySelectorAll('#adminPortal .admin-content').forEach(content => {
                    content.style.display = 'none';
                });

                // Activate the selected content section
                document.getElementById(`${targetId}`).style.display = 'block';

                // Update active button state
                document.querySelectorAll('#adminPortal .admin-nav-btn').forEach(btn => btn.classList.remove('active'));
                e.target.classList.add('active');

                // Re-initialize charts or data if needed
                if (targetId === 'admin-overview') {
                    initAdminCharts();
                    updateAdminDashboardData();
                } else if (targetId === 'admin-users') {
                    updateAdminUsersTable();
                } else if (targetId === 'admin-invoices') {
                    updateAdminInvoicesTable();
                } else if (targetId === 'admin-chat') {
                    updateAdminChatUsers();
                    // If no user selected, disable input
                    if (!currentAdminChatUser) {
                        adminChatInput.disabled = true;
                        adminSendChatBtn.disabled = true;
                        adminChatCurrentUserHeader.textContent = 'Select a user to chat';
                        adminChatDisplay.innerHTML = '<div class="chat-message system">Select a user from the left panel to start chatting.</div>';
                    } else {
                        loadAdminChatMessages(currentAdminChatUser);
                    }
                }
            });
        });

        function initAdminCharts() {
            if (revenueExpenseChart) {
                revenueExpenseChart.destroy(); // Destroy existing chart if it exists
            }
            const ctx = document.getElementById('revenueExpenseChart').getContext('2d');
            revenueExpenseChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul'],
                    datasets: [
                        {
                            label: 'Revenue (ZAR)',
                            data: [12000, 15000, 13000, 17000, 16000, 19000, 15000],
                            backgroundColor: '#FF6600', // Orange
                            borderColor: '#FF6600',
                            borderWidth: 1
                        },
                        {
                            label: 'Expenses (ZAR)',
                            data: [7000, 8000, 7500, 9000, 8500, 9500, 8000],
                            backgroundColor: '#4CAF50', // Green
                            borderColor: '#4CAF50',
                            borderWidth: 1
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                color: '#E0E0E0' // White for Y-axis labels
                            },
                            grid: {
                                color: '#333' // Darker grid lines
                            }
                        },
                        x: {
                            ticks: {
                                color: '#E0E0E0' // White for X-axis labels
                            },
                            grid: {
                                color: '#333'
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            labels: {
                                color: '#FFFFFF' // White for legend text
                            }
                        }
                    }
                }
            });
        }


        // --- Live Chat Functionality (Client Side) ---
        openChatBtn.addEventListener('click', () => {
            if (!currentUser) {
                alert('Please log in to use the live chat.');
                openModal(loginModal);
                loginErrorMessage.textContent = 'You need to be logged in to chat with support.';
                loginErrorMessage.style.display = 'block';
                return;
            }
            openModal(chatModal);
            loadClientChatMessages(currentUser.username); // Load messages for current user
            chatMessagesDisplay.scrollTop = chatMessagesDisplay.scrollHeight; // Scroll to bottom on open
        });

        sendChatBtn.addEventListener('click', sendClientMessage);
        chatInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                sendClientMessage();
            }
        });

        function sendClientMessage() {
            const messageText = chatInput.value.trim();
            if (messageText && currentUser) {
                const timestamp = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                const message = { sender: 'self', message: messageText, timestamp: timestamp };

                if (!chatMessages[currentUser.username]) {
                    chatMessages[currentUser.username] = [];
                }
                chatMessages[currentUser.username].push(message);
                localStorage.setItem('chatMessages', JSON.stringify(chatMessages));

                // Add to client's display
                const messageDiv = document.createElement('div');
                messageDiv.classList.add('chat-message', 'self');
                messageDiv.innerHTML = `<p>${messageText}</p><span class="timestamp">${timestamp}</span>`;
                chatMessagesDisplay.appendChild(messageDiv);
                chatInput.value = '';
                chatMessagesDisplay.scrollTop = chatMessagesDisplay.scrollHeight;

                // Simulate admin response and notify admin portal
                setTimeout(() => {
                    const adminResponse = { sender: 'other', message: 'Got it. An agent will reply soon. Please wait for them.', timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) };
                    chatMessages[currentUser.username].push(adminResponse);
                    localStorage.setItem('chatMessages', JSON.stringify(chatMessages));

                    const responseDiv = document.createElement('div');
                    responseDiv.classList.add('chat-message', 'other');
                    responseDiv.innerHTML = `<p>${adminResponse.message}</p><span class="timestamp">${adminResponse.timestamp}</span>`;
                    chatMessagesDisplay.appendChild(responseDiv);
                    chatMessagesDisplay.scrollTop = chatMessagesDisplay.scrollHeight;

                    // Notify admin of new message (simulated)
                    notifyAdminOfNewMessage(currentUser.username);
                }, 1500);
            }
        }

        function loadClientChatMessages(username) {
            chatMessagesDisplay.innerHTML = '';
            const messages = chatMessages[username] || [];
            messages.forEach(msg => {
                const messageDiv = document.createElement('div');
                messageDiv.classList.add('chat-message', msg.sender);
                messageDiv.innerHTML = `<p>${msg.message}</p><span class="timestamp">${msg.timestamp}</span>`;
                chatMessagesDisplay.appendChild(messageDiv);
            });
            chatMessagesDisplay.scrollTop = chatMessagesDisplay.scrollHeight;
        }


        // --- Admin Live Chat Functionality ---
        function updateAdminChatUsers() {
            adminChatUsersList.innerHTML = '<h4>Active Chats</h4>';
            for (const username in users) {
                // Only list clients for now, or other specific roles
                if (users[username].role === 'client' || users[username].role === 'manager') {
                    const userItem = document.createElement('div');
                    userItem.classList.add('chat-user-item');
                    userItem.dataset.userId = username;
                    userItem.textContent = `${users[username].firstName} (${users[username].role === 'client' ? 'Client' : 'Manager'})`;

                    if (currentAdminChatUser === username) {
                        userItem.classList.add('active');
                    }
                    if (chatMessages[username] && chatMessages[username].some(msg => msg.sender !== 'admin' && !msg.readByAdmin)) {
                         userItem.classList.add('has-new-messages');
                    }


                    userItem.addEventListener('click', () => {
                        selectAdminChatUser(username);
                    });
                    adminChatUsersList.appendChild(userItem);
                }
            }
        }

        function selectAdminChatUser(username) {
            currentAdminChatUser = username;
            adminChatCurrentUserHeader.textContent = `Chatting with: ${users[username].firstName}`;
            adminChatInput.disabled = false;
            adminSendChatBtn.disabled = false;

            // Mark messages as read for this user
            if (chatMessages[username]) {
                chatMessages[username].forEach(msg => {
                    if (msg.sender !== 'admin') {
                        msg.readByAdmin = true;
                    }
                });
                localStorage.setItem('chatMessages', JSON.stringify(chatMessages));
            }

            loadAdminChatMessages(username);
            updateAdminChatUsers(); // Refresh user list to remove 'has-new-messages' class
        }

        function loadAdminChatMessages(username) {
            adminChatDisplay.innerHTML = '';
            const messages = chatMessages[username] || [];
            if (messages.length === 0) {
                 adminChatDisplay.innerHTML = '<div class="chat-message system">No messages yet. Send a message to start the conversation.</div>';
            }
            messages.forEach(msg => {
                const messageDiv = document.createElement('div');
                // Admin's own messages are 'self', others (client/manager) are 'other'
                const senderClass = msg.sender === 'admin' ? 'self' : msg.sender === 'system' ? 'system' : 'other';
                messageDiv.classList.add('chat-message', senderClass);
                messageDiv.innerHTML = `<p>${msg.message}</p><span class="timestamp">${msg.timestamp}</span>`;
                adminChatDisplay.appendChild(messageDiv);
            });
            adminChatDisplay.scrollTop = adminChatDisplay.scrollHeight;
        }

        adminSendChatBtn.addEventListener('click', sendAdminMessage);
        adminChatInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') {
                sendAdminMessage();
            }
        });

        function sendAdminMessage() {
            const messageText = adminChatInput.value.trim();
            if (messageText && currentAdminChatUser) {
                const timestamp = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                const message = { sender: 'admin', message: messageText, timestamp: timestamp };

                if (!chatMessages[currentAdminChatUser]) {
                    chatMessages[currentAdminChatUser] = [];
                }
                chatMessages[currentAdminChatUser].push(message);
                localStorage.setItem('chatMessages', JSON.stringify(chatMessages));

                // Add to admin's display
                const messageDiv = document.createElement('div');
                messageDiv.classList.add('chat-message', 'self');
                messageDiv.innerHTML = `<p>${messageText}</p><span class="timestamp">${timestamp}</span>`;
                adminChatDisplay.appendChild(messageDiv);
                adminChatInput.value = '';
                adminChatDisplay.scrollTop = adminChatDisplay.scrollHeight;

                // Simulate client receiving the message (notifying client chat if open)
                if (currentUser && currentUser.username === currentAdminChatUser) {
                    loadClientChatMessages(currentUser.username);
                }
            }
        }

        // Simulate new message notification for admin
        function notifyAdminOfNewMessage(username) {
            const userItem = adminChatUsersList.querySelector(`[data-user-id="${username}"]`);
            if (userItem && currentAdminChatUser !== username) {
                userItem.classList.add('has-new-messages');
                // In a real app, you'd trigger a desktop notification or sound
                console.log(`New message from ${username}!`);
            } else if (currentAdminChatUser === username) {
                loadAdminChatMessages(username); // Auto-load if admin is already on that chat
            }
        }

        // Initial update calls
        updateCartDisplay();

        // Check login status on page load
        if (currentUser) {
            if (currentUser.role === 'admin') {
                showAdminPortal();
            } else {
                showUserPortal(currentUser.username);
            }
            hideMainSections();
            header.style.display = 'none';
        }

    </script>
</body>
</html>
