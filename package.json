        }
        #adminPortal .admin-header h2 {
            color: #FF6600;
            margin: 0;
            font-size: 2.2em;
        }
        #adminPortal .admin-nav {
            display: flex;
            justify-content: center;
            background-color: #1a1a1a;
            border-bottom: 2px solid #FF6600;
            margin-bottom: 30px;
            padding: 10px 0;
        }
        #adminPortal .admin-nav button {
            background: none;
            border: none;
            color: #FFFFFF;
            padding: 12px 25px;
            font-family: 'Montserrat', sans-serif;
            font-size: 1.1em;
            cursor: pointer;
            position: relative;
            transition: color 0.3s ease;
        }
        #adminPortal .admin-nav button::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 0;
            width: 100%;
            height: 2px;
            background-color: #FF6600;
            transform: scaleX(0);
            transition: transform 0.3s ease;
        }
        #adminPortal .admin-nav button.active::after,
        #adminPortal .admin-nav button:hover::after {
            transform: scaleX(1);
        }
        #adminPortal .admin-nav button.active {
            color: #FF6600;
        }
        #adminPortal .admin-content {
            background-color: #1a1a1a;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
            text-align: left;
            min-height: 400px;
        }
        #adminPortal .admin-content h3 {
            border-bottom: 1px solid #333;
            padding-bottom: 15px;
            margin-bottom: 25px;
            color: #FF6600;
            text-align: center;
        }
        #adminPortal .graph-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-around;
            gap: 30px;
        }

        /* Admin Chat Specific Styles */
        #admin-chat-area {
            display: flex;
            height: 500px;
            border: 1px solid #333;
            border-radius: 8px;
            overflow: hidden;
        }
        #admin-chat-users {
            width: 200px;
            background-color: #0d0d0d;
            border-right: 1px solid #333;
            padding: 15px;
            overflow-y: auto;
        }
        #admin-chat-users h4 {
            color: #FF6600;
            margin-bottom: 15px;
            text-align: center;
        }
        .chat-user-item {
            padding: 10px;
            border-bottom: 1px solid #222;
            cursor: pointer;
            color: #E0E0E0;
            transition: background-color 0.2s ease;
        }
        .chat-user-item:last-child {
            border-bottom: none;
        }
        .chat-user-item.active, .chat-user-item:hover {
            background-color: #333;
            color: #FF6600;
        }
        .chat-user-item.has-new-messages {
            font-weight: bold;
            color: #FFF;
        }

        #admin-chat-window {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            background-color: #1a1a1a;
        }
        #admin-chat-display {
            flex-grow: 1;
            overflow-y: auto;
            padding: 15px;
            display: flex;
            flex-direction: column; /* Ensure messages stack */
        }
        #admin-chat-input-container {
            display: flex;
            padding: 15px;
            border-top: 1px solid #333;
            background-color: #0d0d0d;
        }
        #admin-chat-input {
            flex-grow: 1;
