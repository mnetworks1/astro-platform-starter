            border-radius: 10px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
            text-align: left;
            min-height: 400px;
        }
        #userPortal .portal-content h3 {
            border-bottom: 1px solid #333;
            padding-bottom: 15px;
            margin-bottom: 25px;
            color: #FF6600;
            text-align: center;
        }
        #userPortal .portal-content table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        #userPortal .portal-content table th,
        #userPortal .portal-content table td {
            padding: 12px;
            border-bottom: 1px solid #333;
            text-align: left;
            color: #E0E0E0;
        }
