            padding: 10px;
            border: 1px solid #FF6600;
            border-radius: 5px;
            background-color: #0d0d0d;
            color: #FFFFFF;
            margin-right: 10px;
        }
        #send-chat-btn {
            padding: 10px 15px;
            border-radius: 5px;
        }

        /* Admin Portal Specific Styles */
        #adminPortal {
            display: none; /* Hidden by default */
            min-height: 80vh;
            background-color: #0d0d0d;
            padding-top: 30px;
        }

        #adminPortal .admin-header {
            background-color: #1a1a1a;
            padding: 20px;
            text-align: center;
            border-bottom: 1px solid #FF6600;
            margin-bottom: 30px;
