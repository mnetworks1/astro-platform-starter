            font-weight: bold;
        }
        #userPortal .portal-content table td.status-unpaid {
            color: #FF6600; /* Orange */
            font-weight: bold;
        }
        #userPortal .portal-content .dashboard-summary {
            display: flex;
            justify-content: space-around;
            flex-wrap: wrap;
            gap: 20px;
            margin-bottom: 30px;
            text-align: center;
        }
        #userPortal .portal-content .summary-card {
            background-color: #0d0d0d;
            padding: 20px;
            border-radius: 8px;
            border: 1px solid #333;
            flex: 1;
            min-width: 200px;
