            border-radius: 50%;
            width: 60px;
            height: 60px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 28px;
            box-shadow: 0 4px 15px rgba(0, 123, 255, 0.4);
            cursor: pointer;
            z-index: 1000;
            transition: background-color 0.3s ease, transform 0.2s ease;
        }
        .live-chat-button:hover {
            background-color: #0056b3;
            transform: scale(1.05);
        }

        /* Live Chat Modal */
        #chatModal .modal-content {
            max-width: 400px;
            padding: 20px;
        }
        #chat-messages {
            height: 300px;
            overflow-y: auto;
            border: 1px solid #333;
            background-color: #0d0d0d;
            padding: 10px;
            border-radius: 5px;
            margin-bottom: 15px;
            display: flex;
            flex-direction: column;
        }
        .chat-message {
            margin-bottom: 8px;
            padding: 8px 12px;
            border-radius: 15px;
            max-width: 80%;
            word-wrap: break-word;
            font-size: 0.9em;
        }
        .chat-message.self {
            background-color: #FF6600;
            color: #000000;
            align-self: flex-end;
            text-align: right;
            border-bottom-right-radius: 2px;
        }
        .chat-message.other {
            background-color: #333;
            color: #FFFFFF;
            align-self: flex-start;
            text-align: left;
            border-bottom-left-radius: 2px;
        }
        .chat-message.system {
            background-color: #007BFF;
            color: #FFFFFF;
            align-self: center;
            text-align: center;
            font-size: 0.8em;
            padding: 5px 10px;
            border-radius: 10px;
            margin: 5px auto;
        }
        .chat-message span.timestamp {
            display: block;
            font-size: 0.7em;
            color: #CCC;
            margin-top: 4px;
        }
        .chat-input-container {
            display: flex;
        }
