        const navLinks = document.querySelectorAll('.nav-main ul li a');

        function setActiveNavLink() {
            const sections = document.querySelectorAll('section');
            let currentActive = 'home';

            sections.forEach(section => {
                const sectionTop = section.offsetTop - header.offsetHeight;
                const sectionBottom = sectionTop + section.offsetHeight;
                if (window.scrollY >= sectionTop && window.scrollY < sectionBottom) {
                    currentActive = section.id;
                }
            });

            navLinks.forEach(link => {
                link.classList.remove('active');
                if (link.getAttribute('href') && link.getAttribute('href').includes(currentActive)) {
                    link.classList.add('active');
                }
            });
        }

        window.addEventListener('scroll', setActiveNavLink);
        document.addEventListener('DOMContentLoaded', setActiveNavLink); // Set active on load

        // Smooth scrolling for navigation links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                // If it's a regular navigation link, scroll
                if (!this.classList.contains('external-portal-btn')) {
                    document.querySelector(this.getAttribute('href')).scrollIntoView({
                        behavior: 'smooth'
                    });
                }
            });
        });

